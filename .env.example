# Never commit real credentials.

APP_ENV=development
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/intel_synthesis

# Twitter/twscrape credentials or account setup values belong in local secrets.
# Exact variables may be adapted to the implemented collector.
TWITTER_USERNAME=
TWITTER_EMAIL=
TWITTER_PASSWORD=

# Optional model/cache configuration
HF_HOME=
