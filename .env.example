# Never commit real credentials.

APP_ENV=development

# PostgreSQL Configuration (Docker Compose & Backend)
POSTGRES_DB=social_media_analytics
POSTGRES_USER=social_media_app
POSTGRES_PASSWORD=your_secure_password_here

# PostgreSQL Connection URL (use 127.0.0.1 on Windows to avoid IPv6 connection hangs)
DATABASE_URL=postgresql+psycopg://social_media_app:your_secure_password_here@127.0.0.1:5432/social_media_analytics

# Twitter / twscrape Account Credentials
TWITTER_USERNAME=
TWITTER_EMAIL=
TWITTER_PASSWORD=

# Twitter / twscrape Session Cookies (Required if automated login encounters Cloudflare challenge)
# Format: "auth_token=YOUR_AUTH_TOKEN; ct0=YOUR_CT0"
TWITTER_COOKIES=

# Optional model / HuggingFace cache configuration
HF_HOME=
